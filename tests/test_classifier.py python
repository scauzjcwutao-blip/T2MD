"""Tests for engine.classifier."""

import unittest
from engine.classifier import classify


class TestClassifier(unittest.TestCase):

    def test_pdf_uses_docling(self):
        result = classify("report.pdf")
        self.assertEqual(result["engine"], "docling")

    def test_txt_uses_rules(self):
        result = classify("notes.txt")
        self.assertEqual(result["engine"], "rules")

    def test_docx_uses_docling(self):
        result = classify("file.docx")
        self.assertEqual(result["engine"], "docling")

    def test_unknown_ext_defaults_to_rules(self):
        result = classify("data.xyz")
        self.assertEqual(result["engine"], "rules")


if __name__ == "__main__":
    unittest.main()
